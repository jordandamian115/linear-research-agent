# Optional. With neither model key, the agent still searches and writes locally.
# XAI_API_KEY turns on Grok (default model id grok-3-mini).
XAI_API_KEY=
# OPENAI_API_KEY turns on the OpenAI models named in the notes (gpt-4o / gpt-4o-mini).
OPENAI_API_KEY=
# Optional. Without it, web search uses a keyless request.
TAVILY_API_KEY=
